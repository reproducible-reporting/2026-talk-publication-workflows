axes.spines.top: False
axes.spines.right: False
axes.linewidth: 1.5

# Don't use grids by default.
# Only switch them on in the Python script, not here,
# when they support the data presentation.
axes.grid: False
axes.grid.axis: both
axes.grid.which: major
grid.color: "#cccccc"
grid.linewidth: 1.0

font.family: FiraGo
font.size: 16.0

figure.figsize: 8.5, 5.0
figure.constrained_layout.use: True

legend.fontsize: 16.0
legend.frameon: False

lines.linewidth: 1.5
lines.markersize: 6

xtick.major.size: 7
xtick.minor.size: 4
xtick.major.width: 1.6
xtick.minor.width: 1.2
xtick.major.pad: 7
xtick.minor.pad: 4

ytick.major.size: 7
ytick.minor.size: 4
ytick.major.width: 1.6
ytick.minor.width: 1.2
ytick.major.pad: 7
ytick.minor.pad: 4
